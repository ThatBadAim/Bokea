<?xml version="1.0" encoding="UTF-8"?>
<!--
    What iOS draws between the tap on the icon and the first frame of the app,
    and - because the SplashScreen plugin instantiates this same storyboard
    rather than a view of its own - what is held on screen afterwards until
    mobile-bridge.js says the app has painted. One description, so there is no
    seam in the middle of launch.

    It is the same picture Android draws from splash.xml: the mark, 128 across,
    centred on #09090b. The background is written out in sRGB rather than named
    as systemBackground, which would be white on a phone in light mode and give
    a white flash in front of a dark app.

    The mark itself comes from Splash.imageset, drawn from wwwroot/assets/icon.svg
    by scripts/make-ios-assets.mjs.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina6_12" orientation="portrait" appearance="dark"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <!--
                                Centred by flexible margins on all four sides
                                rather than by constraints: the frame below is
                                exactly centred in the device above, so the four
                                margins grow equally and the mark stays in the
                                middle of any screen, in either orientation.
                            -->
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="Splash" id="snD-IY-ifK">
                                <rect key="frame" x="132.5" y="362" width="128" height="128"/>
                                <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxX="YES" flexibleMinY="YES" flexibleMaxY="YES"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
                        <!-- #09090b -->
                        <color key="backgroundColor" red="0.035294117647058823" green="0.035294117647058823" blue="0.043137254901960784" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="Splash" width="128" height="128"/>
    </resources>
</document>
