<!--
    The tick on its own, white on nothing. Used where Android supplies the
    shape around it: the launcher's adaptive icon, the themed icon and the
    splash screen all mask or tint whatever they are given.

    Drawn on the 108 grid, sized to the inner 72 that every launcher promises
    to keep visible. The splash screen keeps the same two thirds, so one
    drawing serves both.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M40.5,54 L49.5,63 L67.5,40.5"
        android:strokeColor="#ffffff"
        android:strokeWidth="5.625"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
